            <ellipse cx="143" cy="156" rx="8" ry="9" fill="#e0c47e"/>
            <g class="pupils"><ellipse cx="144" cy="156" rx="2.4" ry="7" fill="#111110"/></g>
          </g>

          <!-- monocle on the right eye, chained to the bow tie -->
          <circle cx="143" cy="156" r="13" stroke="url(#gold)" stroke-width="2" fill="rgba(201,169,110,0.08)"/>
          <path d="M153 166 C168 186 160 202 148 206" stroke="url(#gold)" stroke-width="1.1" stroke-dasharray="2 2.5" fill="none"/>
          <path class="glint" d="M149 148 l1.6 3.4 3.4 1.6 -3.4 1.6 -1.6 3.4 -1.6 -3.4 -3.4 -1.6 3.4 -1.6 z" fill="#fff6d6"/>

          <!-- nose, mouth, whiskers -->
          <path d="M126 168 L134 168 L130 173 Z" fill="#d39c8a"/>
          <path d="M130 173 Q130 178 124 179 M130 173 Q130 178 136 179" stroke="#c9a96e" stroke-width="1.2" stroke-linecap="round" fill="none"/>
          <g stroke="rgba(245,242,235,0.45)" stroke-width="0.9" stroke-linecap="round">
            <line x1="108" y1="170" x2="86" y2="166"/>
            <line x1="108" y1="175" x2="86" y2="177"/>
            <line x1="152" y1="170" x2="174" y2="166"/>
            <line x1="152" y1="175" x2="174" y2="177"/>
          </g>
        </g>
      </g>
    </svg>

    <span class="nf-num fade-up d2">404</span>

    <h1 class="nf-title fade-up d3">This moment is <em>lost in time</em></h1>
    <div class="nf-rule fade-up d3"></div>
    <p class="nf-sub fade-up d3">The page you're looking for has moved, been retired, or never existed. Let us guide you back to the collection.</p>

    <div class="nf-btns fade-up d4">
      <a href="/home" class="btn-gold">
        Back to Home
        <span class="btn-arrow">
          <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </span>
      </a>
      <a href="/products" class="btn-outline">Explore the Collection</a>
    </div>

    <p class="nf-path fade-up d4"><span>Requested:</span> <%= typeof requestedUrl !== 'undefined' ? requestedUrl : '' %></p>
  </div>
</main>

<footer class="footer">
  <div class="footer-bottom">
    <span class="footer-copy">&copy; <%= new Date().getFullYear() %> Velmora Chroné. All rights reserved.</span>
    <div class="footer-legal">
      <a href="#">Privacy Policy</a><a href="#">Terms of Service</a><a href="#">Accessibility</a>
    </div>
  </div>
</footer>

<script>
const navbar = document.getElementById('navbar');
window.addEventListener('scroll', () => navbar.classList.toggle('scrolled', scrollY > 30), { passive: true });

const hamburger = document.getElementById('hamburger');
const mobileMenu = document.getElementById('mobileMenu');
hamburger.addEventListener('click', () => {
  hamburger.classList.toggle('open');
  mobileMenu.classList.toggle('open');
});

fetch('/api/cart/count', { headers: { 'Accept': 'application/json' } })
  .then(r => r.json())
  .then(d => { if (d.count !== undefined) document.getElementById('cartBadge').textContent = d.count; })
  .catch(() => {});
</script>
</body>
</html>
